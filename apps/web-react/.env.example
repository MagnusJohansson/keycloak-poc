# Local Docker Keycloak (make up + make seed)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/docvault
VITE_OIDC_CLIENT_ID=docvault-web-react
VITE_API_BASE_URL=http://localhost:5001

# Azure deployment.
#
# AUTHORITY AND API MUST MOVE TOGETHER. An API validates tokens against exactly one
# issuer, so an Azure-issued token presented to the local API (or vice versa) is
# rejected with 401 and this in the API log:
#
#   IDX10205: Issuer validation failed.
#
# Sign-in still works, which is what makes it confusing: the break is at the API call,
# not the login. Either move both lines to Azure, or leave both on localhost - but if
# you point the local API at the Azure issuer (docs/09 Step 3), keep API_BASE_URL local.
#
# VITE_OIDC_AUTHORITY=https://<your-keycloak-host>/realms/docvault
# VITE_API_BASE_URL=https://<your-api-host>
