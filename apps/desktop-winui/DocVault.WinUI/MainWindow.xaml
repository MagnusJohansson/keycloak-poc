<Window
    x:Class="DocVault.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DocVault — Keycloak desktop sample">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="SignInButton" Content="Sign in" Click="OnSignIn" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="DocumentsButton" Content="Load documents" Click="OnLoadDocuments" />
            <Button x:Name="ClassifiedButton" Content="Classified" Click="OnLoadClassified" />
            <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOut" />
        </StackPanel>

        <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" IsClosable="False" />

        <TextBlock x:Name="Identity" Grid.Row="2" IsTextSelectionEnabled="True"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Documents" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView x:Name="Documents" SelectionMode="None" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <!-- The teaching panel: the decoded access token beside the UI reacting to it.
                     Almost every "why am I getting a 403?" is answered by looking at aud,
                     resource_access and acr together. A production app would not ship this. -->
                <TextBlock Text="Access token claims" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <TextBlock x:Name="Claims" FontFamily="Consolas" FontSize="12"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
