# --- secrets ---
.env
.env.local
# Terraform vars hold credentials by default, so ignore them...
*.tfvars
# ...except the local lab's, which contains only admin/admin against a throwaway
# Docker container and MUST be committed - `make seed` and CI both depend on it.
!infra/environments/local/*.tfvars
!infra/environments/**/*.example.tfvars

# --- terraform ---
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.lock.hcl
crash.log

# --- dotnet ---
[Bb]in/
[Oo]bj/
*.user

# --- visual studio ---
# .vs/ holds per-developer editor state and a SQLite index; it is regenerated on
# open and is pure noise in history.
.vs/
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# --- winui / msix packaging ---
# XAML code generation output, rebuilt every compile.
Generated Files/

# MSIX build output - large, and reproducible from source.
AppPackages/
BundleArtifacts/
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload

# Visual Studio silently generates <AppName>_TemporaryKey.pfx when you enable MSIX
# packaging. It is a PRIVATE KEY. Never commit one - in a public repo it is a
# credential leak, and even in a private one it is a signing key in history that
# cannot be un-published. Same for strong-name keys.
*.pfx
*.snk

# --- node ---
node_modules/
dist/
.vite/
playwright-report/
test-results/

# --- flutter ---
.dart_tool/
build/
.flutter-plugins*

# --- misc ---
.DS_Store
*.log
