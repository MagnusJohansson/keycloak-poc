# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored.
#
#   LOCAL LAB -> the defaults below work as-is with `make up`.
#   AZURE     -> swap KEYCLOAK_URL for your deployment's hostname.
# ---------------------------------------------------------------------------

# --- Which Keycloak are we talking to? -------------------------------------
# Local Docker (default):
KEYCLOAK_URL=http://localhost:8080
# An Azure deployment instead (see infra/terraform/10-keycloak-azure):
# KEYCLOAK_URL=https://ca-keycloak.<region>.azurecontainerapps.io

KEYCLOAK_REALM=docvault

# Admin credentials for the *local* Docker Keycloak only.
# In Azure these live in Key Vault - never commit them.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Confidential client secrets (generated by `make seed`) ----------------
# Read them back with: make show-secrets
DOCVAULT_WORKER_SECRET=
DOCVAULT_ANALYTICS_SECRET=

# --- App wiring ------------------------------------------------------------
API_BASE_URL=http://localhost:5001
